# Public URL of the site, used for canonical and hreflang links.
SITE_URL=https://example.com

# Contact form email (Resend). When unset, inquiries are stored but no email is sent.
RESEND_API_KEY=
INQUIRY_EMAIL_TO=
INQUIRY_EMAIL_FROM=

# Dashboard. The first administrator is created from these on first use (then stored, hashed, in the database).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Required: at least 32 random characters, used to sign session cookies.
SESSION_SECRET=


# The local PostgreSQL database that holds everything: content, history, users, inquiries and images.
# Create it once (e.g. createdb gheras), then run: npm run db:migrate
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gheras
# Folder for uploaded images (default: image-uploads/ next to the app). Back it up together with the database.
UPLOADS_DIR=
