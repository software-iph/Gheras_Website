# Copy to .env.production on the server and fill in. Used by docker-compose.yml.

# Database password (the database itself runs in the gheras-db container).
POSTGRES_PASSWORD=

# Public URL of the site, used for canonical and hreflang links. While testing by IP: http://YOUR_SERVER_IP:3001
SITE_URL=

# Dashboard. The first administrator is created from these on first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# At least 32 random characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=

# Set to false ONLY while testing over plain http://IP:3001, so admin sign-in works without HTTPS.
# Remove it (or set true) once the domain with HTTPS is connected.
SESSION_COOKIE_SECURE=false

# Contact form email (Resend). When unset, inquiries are stored but no email is sent.
RESEND_API_KEY=
INQUIRY_EMAIL_TO=
INQUIRY_EMAIL_FROM=
